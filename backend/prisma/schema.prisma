generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ROLES & PERMISSIONS ───────────────────────────────────────

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       UserRole[]
  permissions Permission[]
}

model Permission {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  resource  String
  action    String
  createdAt DateTime     @default(now())
  roles     Role[]
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ─── USERS ─────────────────────────────────────────────────────

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  username          String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  bio               String?            @db.Text
  location          String?
  universityAffiliation String?
  isEmailVerified   Boolean            @default(false)
  isActive          Boolean            @default(true)
  isSuspended       Boolean            @default(false)
  mustChangePassword Boolean          @default(false)
  suspendedAt       DateTime?
  suspensionReason  String?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  roles             UserRole[]
  profile           Profile?
  verificationRequests VerificationRequest[]
  marketplaceListings  MarketplaceListing[]
  services            Service[]
  properties          Property[]
  favorites           Favorite[]
  conversationsParticipant ConversationParticipant[]
  conversationsCreated  Conversation[]      @relation("ConversationCreator")
  messagesSent         Message[]          @relation("MessageSender")
  reviewsWritten       Review[]           @relation("ReviewAuthor")
  reportsSubmitted     Report[]           @relation("ReportReporter")
  notifications        Notification[]
  notificationsAsActor Notification[]    @relation("NotifActor")
  promotionPurchases   PromotionPurchase[]
  payments             Payment[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]
  ordersPlaced         Order[]            @relation("OrderBuyer")
  ordersReceived       Order[]            @relation("OrderSeller")

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model Profile {
  id              Int    @id @default(autoincrement())
  userId          Int    @unique
  displayName     String?
  coverPhoto      String?
  website         String?
  socialLinks     Json?
  isProfilePublic Boolean @default(true)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── VERIFICATION ──────────────────────────────────────────────

model VerificationRequest {
  id              Int                @id @default(autoincrement())
  userId          Int
  type            VerificationType
  status          VerificationStatus @default(PENDING)
  documentUrl     String?
  documentData    Json?
  notes           String?            @db.Text
  reviewedBy      Int?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}

enum VerificationType {
  STUDENT
  SERVICE_PROVIDER
  LANDLORD
  BUSINESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ─── CATEGORIES ────────────────────────────────────────────────

model Category {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  image       String?
  parentId    Int?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]        @relation("CategoryTree")
  listings    MarketplaceListing[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model ServiceCategory {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  services    Service[]

  @@index([slug])
}

model PropertyCategory {
  id          Int               @id @default(autoincrement())
  name        String
  slug        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  properties  Property[]

  @@index([slug])
}

// ─── MARKETPLACE ───────────────────────────────────────────────

model MarketplaceListing {
  id              Int                @id @default(autoincrement())
  userId          Int
  categoryId      Int
  title           String
  slug            String             @unique
  description     String             @db.Text
  price           Decimal            @db.Decimal(12, 2)
  currency        String             @default("UGX")
  condition       ListingCondition
  quantity        Int                @default(1)
  location        String?
  latitude        Decimal?           @db.Decimal(10, 8)
  longitude       Decimal?           @db.Decimal(11, 8)
  status          ListingStatus      @default(DRAFT)
  isNegotiable    Boolean            @default(false)
  viewCount       Int                @default(0)
  featuredAt      DateTime?
  expiresAt       DateTime?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category           @relation(fields: [categoryId], references: [id])
  images          MarketplaceListingImage[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([createdAt])
  @@index([slug])
  @@index([location])
}

model MarketplaceListingImage {
  id        Int               @id @default(autoincrement())
  listingId Int
  url       String
  alt       String?
  sortOrder Int               @default(0)
  isPrimary Boolean           @default(false)
  createdAt DateTime          @default(now())

  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

enum ListingCondition {
  NEW
  USED_EXCELLENT
  USED_GOOD
  USED_FAIR
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  REJECTED
  SUSPENDED
}

// ─── SERVICES ──────────────────────────────────────────────────

model Service {
  id                Int               @id @default(autoincrement())
  userId            Int
  serviceCategoryId Int
  title             String
  slug              String            @unique
  description       String            @db.Text
  priceMin          Decimal?          @db.Decimal(12, 2)
  priceMax          Decimal?          @db.Decimal(12, 2)
  priceType         String?           @default("fixed")
  currency          String            @default("UGX")
  location          String?
  availability      String?
  status            ListingStatus     @default(DRAFT)
  viewCount         Int               @default(0)
  featuredAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceCategory   ServiceCategory   @relation(fields: [serviceCategoryId], references: [id])
  images            ServiceImage[]
  portfolios        ServicePortfolio[]

  @@index([userId])
  @@index([serviceCategoryId])
  @@index([status])
  @@index([slug])
  @@index([createdAt])
}

model ServiceImage {
  id        Int        @id @default(autoincrement())
  serviceId Int
  url       String
  alt       String?
  sortOrder Int        @default(0)
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServicePortfolio {
  id        Int        @id @default(autoincrement())
  serviceId Int
  title     String
  description String?  @db.Text
  imageUrl  String?
  link      String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// ─── ACCOMMODATION ─────────────────────────────────────────────

model Property {
  id                Int               @id @default(autoincrement())
  userId            Int
  propertyCategoryId Int
  title             String
  slug              String            @unique
  description       String            @db.Text
  propertyType      PropertyType
  location          String
  latitude          Decimal?          @db.Decimal(10, 8)
  longitude         Decimal?          @db.Decimal(11, 8)
  monthlyPrice      Decimal           @db.Decimal(12, 2)
  depositAmount     Decimal?          @db.Decimal(12, 2)
  currency          String            @default("UGX")
  distanceFromCampus String?
  totalRooms        Int               @default(1)
  availableRooms    Int               @default(1)
  roomType          String?
  isFurnished       Boolean           @default(false)
  hasWifi           Boolean           @default(false)
  hasWater          Boolean           @default(true)
  hasElectricity    Boolean           @default(true)
  hasSecurity       Boolean           @default(false)
  hasParking        Boolean           @default(false)
  rules             String?           @db.Text
  status            ListingStatus     @default(DRAFT)
  viewCount         Int               @default(0)
  featuredAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyCategory  PropertyCategory  @relation(fields: [propertyCategoryId], references: [id])
  images            PropertyImage[]
  amenities         PropertyAmenity[]

  @@index([userId])
  @@index([propertyCategoryId])
  @@index([status])
  @@index([monthlyPrice])
  @@index([slug])
  @@index([location])
  @@index([createdAt])
}

model PropertyImage {
  id         Int        @id @default(autoincrement())
  propertyId Int
  url        String
  alt        String?
  sortOrder  Int        @default(0)
  isPrimary  Boolean    @default(false)
  createdAt  DateTime   @default(now())

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAmenity {
  id         Int        @id @default(autoincrement())
  propertyId Int
  amenityId  Int
  createdAt  DateTime   @default(now())

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity    @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model Amenity {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  icon      String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  properties PropertyAmenity[]
}

enum PropertyType {
  HOSTEL
  SINGLE_ROOM
  SHARED_ROOM
  APARTMENT
  HOUSE
  BEDSITTER
  OTHER
}

// ─── FAVORITES ─────────────────────────────────────────────────

model Favorite {
  id           Int          @id @default(autoincrement())
  userId       Int
  targetType   FavoriteType
  targetId     Int
  createdAt    DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

enum FavoriteType {
  MARKETPLACE
  SERVICE
  ACCOMMODATION
}

// ─── MESSAGING ─────────────────────────────────────────────────

model Conversation {
  id           Int           @id @default(autoincrement())
  title        String?
  createdBy    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creator      User          @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([createdAt])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ─── REVIEWS ───────────────────────────────────────────────────

model Review {
  id         Int          @id @default(autoincrement())
  authorId   Int
  targetType ReviewType
  targetId   Int
  rating     Int
  title      String?
  content    String?      @db.Text
  status     ReviewStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  author     User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([rating])
}

enum ReviewType {
  SELLER
  SERVICE_PROVIDER
  LANDLORD
  BUSINESS
}

enum ReviewStatus {
  ACTIVE
  HIDDEN
  DELETED
}

// ─── REPORTS ───────────────────────────────────────────────────

model Report {
  id         Int          @id @default(autoincrement())
  reporterId Int
  targetType ReportType
  targetId   Int
  reason     ReportReason
  description String?     @db.Text
  status     ReportStatus @default(OPEN)
  reviewedBy Int?
  reviewedAt DateTime?
  resolution String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([createdAt])
}

enum ReportType {
  LISTING
  SERVICE
  ACCOMMODATION
  USER
  REVIEW
}

enum ReportReason {
  SCAM
  FRAUD
  FAKE_PRODUCT
  FAKE_ACCOMMODATION
  INAPPROPRIATE_CONTENT
  HARASSMENT
  DUPLICATE_LISTING
  WRONG_INFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int
  actorId    Int?
  type       NotificationType
  title      String
  message    String           @db.Text
  targetType String?
  targetId   Int?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_EXPIRED
  NEW_INQUIRY
  REVIEW_RECEIVED
  VERIFICATION_STATUS
  PROMOTION_ACTIVE
  SYSTEM_ANNOUNCEMENT
  REPORT_UPDATE
  ORDER_RECEIVED
  ORDER_UPDATE
}

// ─── PAYMENTS ──────────────────────────────────────────────────

model Payment {
  id              Int           @id @default(autoincrement())
  userId          Int
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("UGX")
  status          PaymentStatus @default(PENDING)
  provider        String?
  providerRef     String?
  description     String?
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

// ─── PROMOTIONS ────────────────────────────────────────────────

model PromotionPlan {
  id          Int              @id @default(autoincrement())
  name        String
  description String?          @db.Text
  type        PromotionType
  price       Decimal          @db.Decimal(12, 2)
  currency    String           @default("UGX")
  durationDays Int
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  purchases   PromotionPurchase[]
}

model PromotionPurchase {
  id              Int              @id @default(autoincrement())
  userId          Int
  planId          Int
  targetType      String
  targetId        Int
  status          PaymentStatus    @default(PENDING)
  startDate       DateTime?
  endDate         DateTime?
  paymentId       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PromotionPlan    @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([targetType, targetId])
  @@index([status])
}

enum PromotionType {
  FEATURED
  PREMIUM
  SPONSORED
  BUSINESS_PLAN
}

// ─── SUBSCRIPTIONS ─────────────────────────────────────────────

model SubscriptionPlan {
  id          Int            @id @default(autoincrement())
  name        String
  description String?        @db.Text
  price       Decimal        @db.Decimal(12, 2)
  currency    String         @default("UGX")
  durationDays Int
  features    Json?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id           Int           @id @default(autoincrement())
  userId       Int
  planId       Int
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime      @default(now())
  endDate      DateTime
  autoRenew    Boolean       @default(false)
  paymentId    Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

// ─── SYSTEM SETTINGS ───────────────────────────────────────────

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  group     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ─── AUDIT LOGS ────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entity     String
  entityId   Int?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── NEWSLETTER ────────────────────────────────────────────────

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  topic     String   @default("accommodation")
  createdAt DateTime @default(now())
}

// ─── CAMPUS EVENTS ─────────────────────────────────────────────

model CampusEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  location    String?
  category    String    @default("Campus")
  startsAt    DateTime
  endsAt      DateTime?
  isPublished Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, startsAt])
}

// ─── ORDERS ────────────────────────────────────────────────────
// A customer's order for an item, booking request for a service, or viewing
// request for a property. Payment happens between the two people directly.

enum OrderTarget {
  LISTING
  SERVICE
  PROPERTY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

model Order {
  id             Int         @id @default(autoincrement())
  buyerId        Int
  sellerId       Int
  targetType     OrderTarget
  targetId       Int
  title          String
  unitPrice      Decimal?    @db.Decimal(12, 2)
  currency       String      @default("UGX")
  quantity       Int         @default(1)
  message        String?     @db.Text
  contactPhone   String
  meetingPlace   String?
  preferredDate  DateTime?
  status         OrderStatus @default(PENDING)
  sellerNote     String?     @db.Text
  conversationId Int?
  respondedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  buyer          User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User        @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([targetType, targetId])
}
